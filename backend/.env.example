# --- Database ---
DATABASE_URL="postgresql://shopxy:shopxy@localhost:5432/shopxy?schema=public"

# --- Server ---
PORT=3003
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- CORS ---
# Comma-separated list of allowed origins. Required — the server refuses to
# boot without it. Use real origins (never `*` with credentials).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-bytes-of-randomness
JWT_REFRESH_SECRET=replace-me-with-64-bytes-of-randomness-different

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=shopxy-uploads

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Or split:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Cron ---
# Set to "1" to disable all cron jobs (handy in tests / one-off scripts).
DISABLE_CRON=

# --- HSN semantic suggestions (optional, OFF by default) ---
# HSN classification runs on a local BM25 index with fuzzy + phonetic matching:
# deterministic, offline, free, sub-millisecond. Set to 1 to additionally fall
# back to embeddings for paraphrases with no shared vocabulary ("thing you fry
# pakoras in" → cooking oil). Needs a key below AND a vectors file built with
# `npm run hsn:embed`. Costs one API request per novel product name.
HSN_SEMANTIC=

# --- Embeddings (optional: product semantic search + HSN suggestions) ---
# Gemini is preferred and wins when its key is set; Ollama is the fallback for
# existing deployments. With neither, both features degrade to lexical matching
# and nothing breaks.
#
# Every provider must emit 768 dimensions — the pgvector column width is fixed
# at migration time, so swapping providers does NOT require re-embedding.
GEMINI_API_KEY=
# Defaults to gemini-embedding-001 (768 dims requested explicitly).
GEMINI_EMBED_MODEL=
GEMINI_BASE_URL=

OLLAMA_BASE_URL=
OLLAMA_KEY=
OLLAMA_EMBED_MODEL=

# --- Payment gateway: Razorpay (optional) ---
# The payment-gateway module enables Razorpay only when KEY_ID + KEY_SECRET are
# both set (see providers/registry.ts) — leave blank to keep it inert. Use
# rzp_test_* keys for development. WEBHOOK_SECRET is the value you set on the
# Razorpay dashboard webhook; signature verification fails closed without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Route on-hold split (marketplace seller payouts). LEAVE OFF.
# When 'true', a captured ORDER fans out to per-shop Razorpay Route transfers
# held on_hold (released on delivery / reversed on return). This MOVES REAL
# SELLER MONEY. It must NOT be enabled until it is sandbox-verified AND
# compliance/legal have signed off on the custody arrangement — see
# src/modules/payment-gateway/ROUTE_SPLIT_DESIGN.md. Default (unset) = off.
ROUTE_SPLIT_ENABLED=false
