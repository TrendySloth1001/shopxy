  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([productId, createdAt(sort: Desc)])
  @@map("product_reviews")
}

model Banner {
  id        Int             @id @default(autoincrement())
  shopId    Int?            @map("shop_id")
  shop      Shop?           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  placement BannerPlacement
  imageUrl  String          @map("image_url")
  linkUrl   String?         @map("link_url")
  sortOrder Int             @default(0) @map("sort_order")
  startAt   DateTime?       @map("start_at")
  endAt     DateTime?       @map("end_at")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  products BannerProduct[]

  @@index([placement, isActive, startAt, endAt])
  @@index([shopId])
  @@map("banners")
}

model BannerProduct {
  id            Int                       @id @default(autoincrement())
  bannerId      Int                       @map("banner_id")
  banner        Banner                    @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  productId     Int                       @map("product_id")
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position      Int                       @default(0)
  discountType  BannerProductDiscountType @default(PERCENT) @map("discount_type")
  discountValue Decimal                   @default(0) @map("discount_value") @db.Decimal(12, 2)
  createdAt     DateTime                  @default(now()) @map("created_at")

  @@unique([bannerId, productId])
  @@index([bannerId, position])
  @@index([productId])
  @@map("banner_products")
}

enum BannerProductDiscountType {
  PERCENT
  AMOUNT
}

enum BannerPlacement {
  HERO
  AD_STRIP
  PROMO
  CURATED_RAIL
}

enum Role {
  OWNER
  CUSTOMER
}

enum RegistrationType {
  REGULAR
  COMPOSITION
  UNREGISTERED
}

model Shop {
  id          Int      @id @default(autoincrement())
  ownerUserId Int      @unique @map("owner_user_id")
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  tagline     String?
  logoUrl     String?  @map("logo_url")
  bannerUrl   String?  @map("banner_url")
  isPublished Boolean  @default(false) @map("is_published")
  rating      Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0) @map("rating_count")

  returnsEnabled     Boolean @default(true) @map("returns_enabled")
  returnWindowDays   Int     @default(7) @map("return_window_days")
  refundMode         String  @default("WALLET") @map("refund_mode")
  returnPolicyNote   String? @map("return_policy_note")
  cancellationPolicy String  @default("UNTIL_SHIPPED") @map("cancellation_policy")

  variantsEnabled Boolean @default(true) @map("variants_enabled")

  pdfTemplateId String @default("classic") @map("pdf_template_id")

  isVerified     Boolean @default(false) @map("is_verified")
  locationCity   String? @map("location_city")
  locationState  String? @map("location_state")
  returnPolicy   String? @map("return_policy")
  shippingPolicy String? @map("shipping_policy")
  refundPolicy   String? @map("refund_policy")

  vacationMode    Boolean @default(false) @map("vacation_mode")
  vacationMessage String? @map("vacation_message")
  operatingHours  Json?   @map("operating_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products               Product[]
  banners                Banner[]
  parties                Party[]
  vendors                Vendor[]
  invoices               Invoice[]
  challans               Challan[]
  purchaseRequests       PurchaseRequest[]
  payments               Payment[]
  stockTransactions      StockTransaction[]
  stockAdjustments       StockAdjustment[]
  invitations            Invitation[]
  customFieldSections    CustomFieldSection[]
  customFieldDefinitions CustomFieldDefinition[]
  counters               Counter[]
  numberingSchemes       NumberingScheme[]
  returnRequests         ReturnRequest[]
  coupons                Coupon[]
  quotations             Quotation[]
  sales                  Sale[]
  linkedAccount          LinkedAccount?
  members                ShopMember[]
  teamRoles              TeamRole[]
  hsnCodes               HsnCode[]
  hsnShortcuts           ShopHsnShortcut[]
  hsnOverrides           ShopHsnOverride[]
  hsnLookupMisses        HsnLookupMiss[]

  @@index([isPublished])
  @@map("shops")
}

model HsnCode {
  id   Int     @id @default(autoincrement())
  code String
  kind HsnKind @default(GOODS)

  description String
  isRatable   Boolean @default(true) @map("is_ratable")
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  cessRate    Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)
  rateRule    Json?   @map("rate_rule")
  rateNote    String? @map("rate_note")

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  isActive Boolean @default(true) @map("is_active")

  shopId Int?  @map("shop_id")
  shop   Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([code, shopId, effectiveFrom])
  @@index([code, isActive])
  @@index([shopId])
  @@map("hsn_codes")
}

enum HsnKind {
  GOODS
  SERVICES
}

model ShopHsnShortcut {
  id     Int  @id @default(autoincrement())
  shopId Int  @map("shop_id")
  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  term  String
  label String
  code  String

  useCount   Int      @default(0) @map("use_count")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, term])
  @@index([shopId, useCount])
  @@map("shop_hsn_shortcuts")
}

model ShopHsnOverride {
  id     Int  @id @default(autoincrement())
  shopId Int  @map("shop_id")
  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  code     String
  gstRate  Decimal @map("gst_rate") @db.Decimal(5, 2)
  cessRate Decimal @default(0) @map("cess_rate") @db.Decimal(5, 2)

  reason String

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active")

  createdByUserId Int?  @map("created_by_user_id")
  createdBy       User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shopId, code, effectiveFrom])
  @@index([shopId, code, isActive])
  @@map("shop_hsn_overrides")
}

model HsnLookupMiss {
  id     Int  @id @default(autoincrement())
  shopId Int  @map("shop_id")
  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  term String

  sample String

  occurrences Int      @default(1)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  resolvedCode String?   @map("resolved_code")
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([shopId, term])
  @@index([resolvedCode, occurrences])
  @@map("hsn_lookup_misses")
}

