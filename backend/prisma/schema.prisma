generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  name              String
  passwordHash      String             @map("password_hash")
  role              String             @default("OWNER")
  isActive          Boolean            @default(true) @map("is_active")
  emailNotifications Boolean           @default(true) @map("email_notifications")
  /// Shop profile fields — rendered on invoices and exposed via the
  /// merchant app's settings screen. Filled in by the owner; nullable so
  /// pre-GST users (and customer-side accounts) work unchanged.
  shopName          String?            @map("shop_name")
  shopAddress       String?            @map("shop_address")
  shopCity          String?            @map("shop_city")
  shopState         String?            @map("shop_state")
  shopStateCode     String?            @map("shop_state_code")
  shopPinCode       String?            @map("shop_pin_code")
  shopGstin         String?            @map("shop_gstin")
  shopPan           String?            @map("shop_pan")
  upiVpa            String?            @map("upi_vpa")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  refreshTokens     RefreshToken[]
  stockTransactions StockTransaction[]
  stockAdjustments  StockAdjustment[]

  invitationsSent     Invitation[]   @relation("InvitationsSent")
  invitationsReceived Invitation[]   @relation("InvitationsReceived")
  notifications       Notification[]
  linkedParties       Party[]
  linkedVendors       Vendor[]
  purchaseRequests    PurchaseRequest[] @relation("CustomerPurchaseRequests")
  decidedRequests     PurchaseRequest[] @relation("MerchantDecidedRequests")
  paymentsCreated     Payment[]         @relation("PaymentCreatedBy")

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id                Int      @id @default(autoincrement())
  name              String
  description       String?
  sku               String   @unique
  barcode           String?  @unique
  hsnCode           String?  @map("hsn_code")

  mrp               Decimal  @db.Decimal(12, 2)
  sellingPrice      Decimal  @map("selling_price") @db.Decimal(12, 2)
  purchasePrice     Decimal  @map("purchase_price") @db.Decimal(12, 2)
  taxPercent        Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)

  stockQuantity     Decimal  @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  lowStockThreshold Decimal  @default(10) @map("low_stock_threshold") @db.Decimal(12, 3)
  unit              String   @default("PCS")

  categoryId        Int?     @map("category_id")
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  stockTransactions    StockTransaction[]
  images               ProductImage[]
  invoiceItems         InvoiceItem[]
  costLayers           CostLayer[]
  stockAdjustmentItems StockAdjustmentItem[]
  purchaseRequestItems PurchaseRequestItem[]
  customFieldValues    ProductCustomFieldValue[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@map("products")
}

/// Shop-wide section that groups [CustomFieldDefinition]s on the
/// product form and detail page. Optional — a field with no
/// [sectionId] renders ungrouped at the top, the same way it did
/// before sections existed.
model CustomFieldSection {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  /// Material icon name (e.g. "verified", "build", "local_shipping").
  /// Stored as a string so the frontend can swap icon sets without a
  /// migration.
  icon      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fields CustomFieldDefinition[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("custom_field_sections")
}

/// Shop-wide custom field definitions. One row per field a shop owner
/// wants to track across their products (Warranty, Model number, etc).
/// Soft-deletable via `isActive` — keeps historical values readable
/// even when a definition is retired.
model CustomFieldDefinition {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  /// TEXT | LONG_TEXT | NUMBER | DATE | BOOLEAN | DROPDOWN
  type       String
  /// JSON array of strings — only meaningful when type=DROPDOWN.
  options    Json?
  /// Optional suffix for NUMBER fields (e.g. "kg", "days", "GB").
  unitSuffix String?  @map("unit_suffix")
  /// Optional Material icon name for the field itself; falls back to
  /// the section's icon when null.
  icon       String?
  /// Optional grouping. Null = ungrouped (rendered at the top of the
  /// custom-fields section).
  sectionId  Int?     @map("section_id")
  section    CustomFieldSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  values ProductCustomFieldValue[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([sectionId])
  @@map("custom_field_definitions")
}

/// Per-product value for a [CustomFieldDefinition]. Stored as String
/// regardless of underlying type — the controller parses against the
/// definition's `type` before validating or returning. Cascades on
/// product or definition delete so we never leave orphan rows.
model ProductCustomFieldValue {
  id           Int                   @id @default(autoincrement())
  productId    Int                   @map("product_id")
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId Int                   @map("definition_id")
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, definitionId])
  @@index([definitionId])
  @@map("product_custom_field_values")
}

/// Immutable stock ledger entry. Every inventory movement (manual, sale,
/// purchase, challan, adjustment, opening) is a row here. The product's
/// `stockQuantity` is a derived cache of stockAfter on the latest row.
model StockTransaction {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId  Int?    @map("vendor_id")
  vendor    Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // ── Ledger essentials ────────────────────────────────────────────
  /// 'IN' or 'OUT' — explicit direction. Quantity is always positive.
  direction String
  /// Why this movement happened. One of:
  /// SALE, PURCHASE, OPENING, DAMAGE, EXPIRED, SHRINKAGE, RECOUNT,
  /// RETURN_IN, RETURN_OUT, TRANSFER_IN, TRANSFER_OUT.
  reasonCode String @map("reason_code")
  /// What posted this row. MANUAL / INVOICE / CHALLAN / ADJUSTMENT / OPENING.
  sourceType String @default("MANUAL") @map("source_type")
  /// Polymorphic id pointing at the source document.
  sourceId     Int? @map("source_id")
  sourceLineId Int? @map("source_line_id")

  /// Always positive. Sign comes from `direction`.
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal? @map("unit_cost") @db.Decimal(12, 4)
  totalValue Decimal? @map("total_value") @db.Decimal(14, 2)

  /// Snapshot of product.stockQuantity at the moment of posting.
  stockBefore Decimal? @map("stock_before") @db.Decimal(12, 3)
  stockAfter  Decimal? @map("stock_after") @db.Decimal(12, 3)

  /// Snapshot of the counterparty (vendor or party) identity at the
  /// moment of posting. Survives deletion of the vendor/party record.
  counterpartyName  String? @map("counterparty_name")
  counterpartyGstin String? @map("counterparty_gstin")

  // ── Legacy / metadata kept around ────────────────────────────────
  /// Legacy type column ('STOCK_IN' | 'STOCK_OUT' | 'ADJUSTMENT').
  /// New code should read `direction` + `reasonCode` instead; this is
  /// retained so old reports / DTO consumers don't break mid-migration.
  type                String
  unitPrice           Decimal? @map("unit_price") @db.Decimal(12, 2)
  supplierName        String?  @map("supplier_name")
  purchasePriceMode   String?  @map("purchase_price_mode")
  purchasePriceBefore Decimal? @map("purchase_price_before") @db.Decimal(12, 2)
  purchasePriceAfter  Decimal? @map("purchase_price_after") @db.Decimal(12, 2)
  note                String?

  // ── Reversal linkage ─────────────────────────────────────────────
  /// If non-null, this row reverses an earlier row (cancellation).
  reversesId Int?              @unique @map("reverses_id")
  reverses   StockTransaction? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy StockTransaction? @relation("LedgerReversal")

  // ── Operator + idempotency ───────────────────────────────────────
  createdById    Int?    @map("created_by_id")
  createdBy      User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  costConsumptions CostConsumption[] @relation("LedgerConsumes")
  costLayer        CostLayer?        @relation("LedgerOriginated")

  @@index([productId, createdAt])
  @@index([type])
  @@index([reasonCode])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@index([vendorId])
  @@map("stock_transactions")
}

/// One FIFO cost layer per stock-in. Sales consume layers oldest-first.
model CostLayer {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qtyReceived  Decimal @map("qty_received") @db.Decimal(12, 3)
  qtyRemaining Decimal @map("qty_remaining") @db.Decimal(12, 3)
  unitCost     Decimal @map("unit_cost") @db.Decimal(12, 4)

  sourceType String @map("source_type")
  sourceId   Int?   @map("source_id")

  /// The IN ledger row that created this layer.
  ledgerEntryId Int              @unique @map("ledger_entry_id")
  ledgerEntry   StockTransaction @relation("LedgerOriginated", fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  consumptions CostConsumption[]
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([productId, qtyRemaining])
  @@map("cost_layers")
}

/// Records which OUT ledger row consumed how much of which layer.
/// Lets us reverse stock-outs by restoring qty to the original layers.
model CostConsumption {
  id      Int       @id @default(autoincrement())
  layerId Int       @map("layer_id")
  layer   CostLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)

  ledgerEntryId Int              @map("ledger_entry_id")
  ledgerEntry   StockTransaction @relation("LedgerConsumes", fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  qtyConsumed Decimal  @map("qty_consumed") @db.Decimal(12, 3)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(12, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([layerId])
  @@index([ledgerEntryId])
  @@map("cost_consumptions")
}

/// A stock adjustment is a first-class document (like an invoice) that
/// groups one or more product write-offs/corrections under a reason.
model StockAdjustment {
  id           Int    @id @default(autoincrement())
  adjustmentNo String @unique @map("adjustment_no")
  /// DAMAGE / EXPIRED / SHRINKAGE / RECOUNT / OPENING.
  reasonCode String @map("reason_code")
  /// 'IN' (recount delta + or opening) or 'OUT' (damage/expired/etc).
  direction   String
  note        String?
  createdById Int?    @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  items StockAdjustmentItem[]

  @@index([reasonCode])
  @@index([createdAt])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           Int             @id @default(autoincrement())
  adjustmentId Int             @map("adjustment_id")
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    Int             @map("product_id")
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName  String          @map("product_name")
  productSku   String          @map("product_sku")
  unit         String          @default("PCS")
  quantity     Decimal         @db.Decimal(12, 3)
  unitCost     Decimal?        @map("unit_cost") @db.Decimal(12, 4)
  note         String?

  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_items")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_images")
}

model Vendor {
  id                Int                @id @default(autoincrement())
  name              String
  contactName       String?            @map("contact_name")
  phone             String?
  email             String?
  address           String?
  city              String?
  state             String?
  stateCode         String?            @map("state_code")
  pinCode           String?            @map("pin_code")
  panNumber         String?            @map("pan_number")
  gstin             String?
  isActive          Boolean            @default(true) @map("is_active")
  /// Once an invited vendor accepts via their Shopxy account this is set to
  /// their user id — lets the vendor see their own POs in a future portal.
  linkedUserId      Int?               @map("linked_user_id")
  linkedUser        User?              @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  stockTransactions StockTransaction[]
  invoices          Invoice[]
  invitations       Invitation[]
  payments          Payment[]

  @@index([name])
  @@index([isActive])
  @@index([linkedUserId])
  @@map("vendors")
}

model Party {
  id          Int       @id @default(autoincrement())
  name        String
  contactName String?   @map("contact_name")
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  stateCode   String?   @map("state_code")
  pinCode     String?   @map("pin_code")
  panNumber   String?   @map("pan_number")
  gstin       String?
  isActive    Boolean   @default(true) @map("is_active")
  /// True for system-managed parties (e.g. "Walk-in Customer") — the UI
  /// hides delete/edit affordances and stock flows fall back to this row
  /// when no party is picked.
  isSystem    Boolean   @default(false) @map("is_system")
  /// Once an invited party accepts via their Shopxy account this is set to
  /// their user id — lets the party see their own ledger in a future portal.
  linkedUserId Int?     @map("linked_user_id")
  linkedUser   User?    @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  challans    Challan[]
  invoices    Invoice[]
  invitations Invitation[]
  purchaseRequests PurchaseRequest[]
  payments    Payment[]

  @@index([name])
  @@index([isActive])
  @@index([linkedUserId])
  @@map("parties")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNo     String        @unique @map("invoice_no")
  type          String
  /// One of TAX_INVOICE | BILL_OF_SUPPLY | ESTIMATE | PROFORMA |
  /// CREDIT_NOTE | DEBIT_NOTE. Renders as the document title at the top of
  /// the printed PDF and drives the invoice-number prefix.
  documentType  String        @default("TAX_INVOICE") @map("document_type")
  /// Indian FY ("25-26"). Denormalised so report filters and the
  /// invoice-number reset boundary survive without parsing invoiceDate.
  financialYear String        @map("financial_year")
  status        String        @default("DRAFT")
  vendorId      Int?          @map("vendor_id")
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  partyId       Int?          @map("party_id")
  party         Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  customerName  String?       @map("customer_name")
  customerPhone String?       @map("customer_phone")
  customerGstin String?       @map("customer_gstin")
  customerAddress   String?   @map("customer_address")
  customerCity      String?   @map("customer_city")
  customerState     String?   @map("customer_state")
  customerStateCode String?   @map("customer_state_code")
  customerPinCode   String?   @map("customer_pin_code")
  customerPanNumber String?   @map("customer_pan_number")
  vendorName    String?       @map("vendor_name")
  vendorPhone   String?       @map("vendor_phone")
  vendorGstin   String?       @map("vendor_gstin")
  vendorAddress     String?   @map("vendor_address")
  vendorCity        String?   @map("vendor_city")
  vendorState       String?   @map("vendor_state")
  vendorStateCode   String?   @map("vendor_state_code")
  vendorPinCode     String?   @map("vendor_pin_code")
  vendorPanNumber   String?   @map("vendor_pan_number")
  /// 2-digit GST state code of the place of supply. Drives IGST vs
  /// CGST+SGST: when it differs from the shop's stateCode we charge IGST.
  placeOfSupplyStateCode String? @map("place_of_supply_state_code")
  /// Cached at create time so legacy code paths don't have to re-derive.
  isInterstate  Boolean       @default(false) @map("is_interstate")
  subtotal      Decimal       @db.Decimal(12, 2)
  /// Sum of (qty * unitPrice - lineDiscount) across items — the GST
  /// "taxable value" before tax + cess.
  taxableValue  Decimal       @default(0) @map("taxable_value") @db.Decimal(12, 2)
  /// Kept for backwards-compatibility with older clients. Equals
  /// igstAmount + cgstAmount + sgstAmount + cessAmount.
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  igstAmount    Decimal       @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cgstAmount    Decimal       @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal       @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  cessAmount    Decimal       @default(0) @map("cess_amount") @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  /// Delta applied to round the grand total to the nearest whole rupee.
  /// `total = sum(lineTotals) + roundOff`.
  roundOff      Decimal       @default(0) @map("round_off") @db.Decimal(6, 2)
  total         Decimal       @db.Decimal(12, 2)
  /// "Rupees X and Paise Y only" — pre-rendered for the printed PDF.
  amountInWords String?       @map("amount_in_words")
  note          String?
  invoiceDate   DateTime      @default(now()) @map("invoice_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  items         InvoiceItem[]
  challan       Challan?
  purchaseRequest PurchaseRequest?
  payments      Payment[]

  @@index([type])
  @@index([status])
  @@index([invoiceDate])
  @@index([vendorId])
  @@index([partyId])
  @@index([financialYear])
  @@index([financialYear, type])
  @@index([placeOfSupplyStateCode])
  @@map("invoices")
}

model Challan {
  id         Int           @id @default(autoincrement())
  challanNo  String        @unique @map("challan_no")
  status     String        @default("PENDING")
  partyId    Int?          @map("party_id")
  party      Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName  String        @map("party_name")
  partyPhone String?       @map("party_phone")
  note       String?
  invoiceId  Int?          @unique @map("invoice_id")
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  items      ChallanItem[]

  @@index([status])
  @@index([createdAt])
  @@index([partyId])
  @@map("challans")
}

model ChallanItem {
  id          Int      @id @default(autoincrement())
  challanId   Int      @map("challan_id")
  challan     Challan  @relation(fields: [challanId], references: [id], onDelete: Cascade)
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  productSku  String   @map("product_sku")
  unit        String   @default("PCS")
  quantity    Decimal  @db.Decimal(12, 3)

  @@index([challanId])
  @@map("challan_items")
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  invoiceId  Int      @map("invoice_id")
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String  @map("product_name")
  productSku String   @map("product_sku")
  hsn        String?
  unit       String   @default("PCS")
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxPercent Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  /// (quantity * unitPrice) - discount. Pre-tax, pre-cess.
  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  igstAmount Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cgstAmount Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  cessRate   Decimal  @default(0) @map("cess_rate") @db.Decimal(5, 2)
  cessAmount Decimal  @default(0) @map("cess_amount") @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

/// Cross-account invite: shop owner invites a party (customer) or vendor
/// (supplier) by email. If a user with that email already exists, an
/// in-app notification is created immediately; otherwise the row sits
/// PENDING and is claimed at signup.
model Invitation {
  id          Int       @id @default(autoincrement())
  /// Inviter (shop owner). Cascades on user delete.
  fromUserId  Int       @map("from_user_id")
  fromUser    User      @relation("InvitationsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  /// Always stored lower-cased so the partial-unique pending index works.
  toEmail     String    @map("to_email")
  /// Set once a user with this email exists (either already, or after signup).
  toUserId    Int?      @map("to_user_id")
  toUser      User?     @relation("InvitationsReceived", fields: [toUserId], references: [id], onDelete: SetNull)

  /// PARTY or VENDOR.
  linkType    String    @map("link_type")
  partyId     Int?      @map("party_id")
  party       Party?    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  vendorId    Int?      @map("vendor_id")
  vendor      Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// PENDING / ACCEPTED / DECLINED / CANCELLED / EXPIRED.
  status      String    @default("PENDING")
  message     String?
  /// Snapshot of the inviting shop's display name, kept independent of
  /// the user's profile mutating later.
  fromShopName String?  @map("from_shop_name")
  /// Snapshot of the invited party/vendor name at send time.
  displayName String?   @map("display_name")

  /// Opaque token used for future email deep-links.
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Compound indexes that cover the only three hot paths:
  //   1. claim-at-signup: lookup by (toEmail, status='PENDING')
  //   2. inbox list:      lookup by (toUserId, status, createdAt)
  //   3. outbox list:     lookup by (fromUserId, status, createdAt)
  @@index([toEmail, status])
  @@index([toUserId, status, createdAt])
  @@index([fromUserId, status, createdAt])
  @@index([status, expiresAt])
  @@map("invitations")
}

/// Per-user in-app notification. Reads / unread-count are indexed off
/// (userId, readAt) so unread-count is an index-only scan.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// INVITE_RECEIVED / INVITE_ACCEPTED / INVITE_DECLINED / INVITE_CANCELLED / GENERIC.
  kind      String
  title     String
  body      String?
  /// JSON payload — invitationId, partyId, vendorId, etc.
  data      Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A customer-app order: the customer browses the merchant catalog,
/// builds a cart, and submits it as a PurchaseRequest. The merchant
/// reviews the inbox and either confirms (which creates a SALE invoice)
/// or rejects. PurchaseRequestItem snapshots product identity + price
/// at submit time so the customer's order is stable even if the
/// merchant later edits product details.
model PurchaseRequest {
  id              Int       @id @default(autoincrement())
  /// Customer who placed the order. Cascades on user delete.
  customerUserId  Int       @map("customer_user_id")
  customerUser    User      @relation("CustomerPurchaseRequests", fields: [customerUserId], references: [id], onDelete: Cascade)
  /// If the customer is a linked party, we point at the existing Party
  /// row so the merchant can correlate orders → their party ledger.
  /// Lazy-created on confirm when the customer was never invited.
  partyId         Int?      @map("party_id")
  party           Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)

  /// Snapshots of customer identity at submit time. Survives later
  /// profile changes and lets the merchant render a usable display
  /// without a User join.
  customerName    String    @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  customerEmail   String?   @map("customer_email")
  customerAddress String?   @map("customer_address")

  /// PENDING / CONFIRMED / REJECTED / CANCELLED.
  /// CONFIRMED rows always have invoiceId set.
  status          String    @default("PENDING")

  /// SALE invoice that materialised this request, if confirmed.
  invoiceId       Int?      @unique @map("invoice_id")
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// Merchant user who acted on the request. Set on confirm/reject.
  decidedById     Int?      @map("decided_by_id")
  decidedBy       User?     @relation("MerchantDecidedRequests", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt       DateTime? @map("decided_at")
  decisionNote    String?   @map("decision_note")

  note            String?
  /// Cached snapshot of cart subtotal (sum of item.total) at submit time.
  /// Backend recomputes from current price on confirm so this is just a
  /// preview number for the customer's order list.
  estimatedTotal  Decimal   @default(0) @map("estimated_total") @db.Decimal(12, 2)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  items           PurchaseRequestItem[]

  /// Hot paths:
  ///   1. customer's order list: (customerUserId, createdAt DESC)
  ///   2. merchant inbox:        (status, createdAt DESC)
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
  @@index([partyId])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id          Int             @id @default(autoincrement())
  requestId   Int             @map("request_id")
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId   Int             @map("product_id")
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  /// Snapshots of product identity + price at submit time. Stable for
  /// the customer even if the merchant edits the product later.
  productName String          @map("product_name")
  productSku  String          @map("product_sku")
  unit        String          @default("PCS")
  quantity    Decimal         @db.Decimal(12, 3)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  total       Decimal         @db.Decimal(12, 2)

  @@index([requestId])
  @@index([productId])
  @@map("purchase_request_items")
}

/// Money in / money out against a party (RECEIPT) or vendor (PAYMENT).
/// Payments are first-class ledger rows that interleave with invoices on
/// the party/vendor detail page to drive a running balance. Optionally
/// allocated to one invoice; otherwise treated as on-account credit.
model Payment {
  id              Int      @id @default(autoincrement())
  /// 'RECEIPT' (money in from a party) or 'PAYMENT' (money out to a vendor).
  type            String
  referenceNo     String   @unique @map("reference_no")
  amount          Decimal  @db.Decimal(12, 2)
  /// CASH | UPI | NEFT | RTGS | CHEQUE | CARD | OTHER.
  mode            String
  /// Free-form ref (UPI txn id, cheque no, etc.).
  modeReference   String?  @map("mode_reference")
  paymentDate     DateTime @default(now()) @map("payment_date")
  /// Exactly one of partyId / vendorId is set (depending on type).
  partyId         Int?     @map("party_id")
  party           Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  vendorId        Int?     @map("vendor_id")
  vendor          Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Optional direct allocation to one invoice. Null = on-account credit.
  invoiceId       Int?     @map("invoice_id")
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  note            String?
  /// Owner who recorded the payment.
  createdById     Int?     @map("created_by_id")
  createdBy       User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([partyId, paymentDate])
  @@index([vendorId, paymentDate])
  @@index([invoiceId])
  @@map("payments")
}

/// Monotonic counter keyed by an arbitrary string. Used to allocate
/// invoice/challan numbers atomically: a Postgres UPSERT increment
/// returns the next value in one round-trip, defeating the `count()+1`
/// race flagged in audit C4.
model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}
