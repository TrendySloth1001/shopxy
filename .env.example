# Full-stack production compose config (compose.yaml). Copy to `.env` and
# fill in real values before `docker compose up -d`. This is the ONE file
# that needs to change when you set up a fresh server or migrate to a new
# one — everything else (images, volumes) is portable.
#
# See readmes/deploy-migration.md for the first-time-setup and
# migrate-to-a-new-server runbooks.

# --- Postgres ---
POSTGRES_USER=shopxy
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=shopxy
# Host is the compose service name "postgres", not localhost.
DATABASE_URL=postgresql://shopxy:replace-me@postgres:5432/shopxy?schema=public

# --- Backend (Express + Prisma) ---
# Generate both with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-64-bytes-of-randomness
JWT_REFRESH_SECRET=replace-me-with-64-bytes-of-randomness-different
# Comma-separated list of the real origins the browser will use — the two
# web apps below, plus the Flutter apps' origin if they call the API
# cross-origin. Never "*" — the server refuses to boot without this.
CORS_ORIGINS=https://shop.yourdomain.com,https://merchant.yourdomain.com

# --- MinIO (S3-compatible object storage) ---
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me-different
MINIO_BUCKET=shopxy-uploads

# --- merchant-web ---
# Browser-reachable WebSocket origin for the live Scan console (the one
# place the browser talks to the backend directly). Baked in at build time —
# changing it means rebuilding the merchant-web image
# (`docker compose build merchant-web`). Use wss:// in production.
NEXT_PUBLIC_BACKEND_WS_URL=wss://api.yourdomain.com

# --- Optional backend features (see backend/.env.example for the full list:
# HSN semantic suggestions, embeddings provider, Razorpay). Uncomment and set
# only what you use; everything degrades gracefully when unset.
# GEMINI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
