# Local-only docs/readmes. Keep working notes, design docs, and README files
# here instead of scattering tracked .md files across the repo. Not committed.
readmes/

# Desktop installer artifacts (large binaries — built locally, never committed).
dist/
*.dmg

# Full-stack compose secrets (DB/JWT/MinIO creds, API keys). Copy from
# .env.example, never commit the filled-in version.
.env
shopxy-backup-*.tar.gz

# Google OAuth client secret downloads (Google Cloud Console "Download
# JSON") — contain a client secret. Never commit; the Client ID alone
# (not the secret) is what actually goes into .env as GOOGLE_CLIENT_ID_*.
client_secret_*.json

node_modules/
.DS_Store
*.swp
*.swo
*~
.claude/scheduled_tasks.lock
