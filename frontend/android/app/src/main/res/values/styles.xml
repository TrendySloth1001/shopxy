<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No splash: windowBackground is a flat colour matching the app canvas,
         not a launch drawable. A plain colour also themes the Android 12+
         system splash, which falls back to windowBackground. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <!-- The colour behind the Flutter UI for the rest of the run. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
